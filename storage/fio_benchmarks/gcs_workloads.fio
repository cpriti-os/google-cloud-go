; FIO Benchmark Suite for GCS Go SDK & GCSFuse Live Cloud Workloads
; Running Live Against GCS Prod Bucket Mounted via GCSFuse

[global]
ioengine=sync
direct=1
runtime=15
time_based=1
group_reporting=1
filename_format=fio_live_gcs_$jobnum_$filenum.dat
directory=/usr/local/google/home/cpriti/gcs_bench_mount

; -----------------------------------------------------------------------------
; Profile 1: AI/ML Dataloader Sequential Read (Large Batch Shards)
; -----------------------------------------------------------------------------
[ai_dataloader_seq_read]
description=Live GCS Read: PyTorch/TensorFlow DataLoader streaming training shards
rw=read
bs=1M
size=128M
numjobs=4

; -----------------------------------------------------------------------------
; Profile 2: Orbax / Model Checkpoint Large Sequential Write
; -----------------------------------------------------------------------------
[orbax_checkpoint_seq_write]
description=Live GCS Write: Orbax multi-node model checkpointing
rw=write
bs=16M
size=256M
numjobs=4

; -----------------------------------------------------------------------------
; Profile 3: Columnar Parquet / Analytics Strided Range Scans
; -----------------------------------------------------------------------------
[columnar_parquet_scan]
description=Live GCS Range Scan: BigQuery / DuckDB column projections
rw=randread
bs=256k
size=64M
numjobs=4

; -----------------------------------------------------------------------------
; Profile 4: Microservices / Small File Ingestion
; -----------------------------------------------------------------------------
[small_file_high_qps]
description=Live GCS Ingestion: High-concurrency small file ingestion
rw=randrw
rwmixread=70
bs=64k
size=32M
numjobs=8
